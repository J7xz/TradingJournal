@model J7Journal.Models.AnalyticsViewModel
@{
    ViewBag.Title = "Analytics";
    var totalTrades = Model.TotalTrades;
    var winRate = Model.WinRate;
    var totalPnL = Model.TotalPnL;
    var profitFactor = Model.ProfitFactor;
    var hasLoss = Model.FilteredTrades.Any(t => t.ProfitLoss < 0);
}

<div class="fade-in-up">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">
                <i class="fas fa-chart-pie me-2" style="color: var(--accent-blue);"></i>Analytics
            </h1>
            <p class="text-secondary m-0" style="font-size: 0.95rem;">
                <i class="fas fa-database me-1"></i>
                Analyzing @totalTrades trades
                @if (Model.TimeframeFilter != "all")
                {
                    <span class="ms-1">• <i class="far fa-calendar-alt me-1"></i>@Model.TimeframeFilter.Replace("days", "D")</span>
                }
            </p>
        </div>
    </div>

    <!-- Timeframe Filter -->
    <div class="card-glass mb-4">
        <div class="card-body">
            <div class="row align-items-center g-2">
                <div class="col-md-3">
                    <label class="fw-bold text-secondary" style="font-size: 0.85rem;">
                        <i class="fas fa-filter me-1"></i> Timeframe
                    </label>
                </div>
                <div class="col-md-9">
                    <div class="d-flex flex-wrap gap-2" id="timeframeFilter">
                        <button class="btn @(Model.TimeframeFilter == "7days" ? "btn-primary-custom" : "btn-outline-custom")" data-value="7days" style="font-size: 0.85rem; padding: 0.4rem 1rem;">
                            7 Days
                        </button>
                        <button class="btn @(Model.TimeframeFilter == "30days" ? "btn-primary-custom" : "btn-outline-custom")" data-value="30days" style="font-size: 0.85rem; padding: 0.4rem 1rem;">
                            30 Days
                        </button>
                        <button class="btn @(Model.TimeframeFilter == "all" ? "btn-primary-custom" : "btn-outline-custom")" data-value="all" style="font-size: 0.85rem; padding: 0.4rem 1rem;">
                            All Time
                        </button>
                        <button class="btn @(Model.TimeframeFilter == "custom" ? "btn-primary-custom" : "btn-outline-custom")" data-value="custom" style="font-size: 0.85rem; padding: 0.4rem 1rem;">
                            <i class="fas fa-calendar-alt me-1"></i> Custom
                        </button>
                    </div>
                    <div class="row g-2 mt-2" id="customRange" style="display: @(Model.TimeframeFilter == "custom" ? "flex" : "none");">
                        <div class="col-md-4">
                            <input type="date" class="form-control form-control-custom" id="startDate" value="@Model.StartDate?.ToString(" yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <input type="date" class="form-control form-control-custom" id="endDate" value="@Model.EndDate?.ToString(" yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary-custom w-100" id="applyCustomRange">
                                <i class="fas fa-check me-2"></i>Apply
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-card text-center">
                <div class="stat-icon mx-auto" style="background: rgba(79, 140, 247, 0.15); color: var(--accent-blue); width: 40px; height: 40px;">
                    <i class="fas fa-exchange-alt"></i>
                </div>
                <div class="stat-label">Total Trades</div>
                <div class="stat-value" style="font-size: 1.5rem;">@totalTrades</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-card text-center">
                <div class="stat-icon mx-auto" style="background: rgba(46, 204, 113, 0.15); color: var(--accent-green); width: 40px; height: 40px;">
                    <i class="fas fa-percent"></i>
                </div>
                <div class="stat-label">Win Rate</div>
                <div class="stat-value" style="font-size: 1.5rem;">@winRate%</div>
                <div style="font-size: 0.7rem; color: var(--text-muted);">
                    @Model.WinningTrades / @Model.LosingTrades
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-card text-center">
                <div class="stat-icon mx-auto" style="background: rgba(241, 196, 15, 0.15); color: var(--accent-gold); width: 40px; height: 40px;">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="stat-label">Total P&L</div>
                <div class="stat-value @(totalPnL >= 0 ? "text-profit" : "text-loss")" style="font-size: 1.5rem;">
                    @(totalPnL >= 0 ? "+" : "")$@totalPnL.ToString("F2")
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-card text-center">
                <div class="stat-icon mx-auto" style="background: rgba(108, 92, 231, 0.15); color: #6c5ce7; width: 40px; height: 40px;">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stat-label">Profit Factor</div>
                <div class="stat-value" style="font-size: 1.5rem;">@profitFactor</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-card text-center">
                <div class="stat-icon mx-auto" style="background: rgba(46, 204, 113, 0.15); color: var(--accent-green); width: 40px; height: 40px;">
                    <i class="fas fa-trophy"></i>
                </div>
                <div class="stat-label">Best / Worst</div>
                <div class="stat-value" style="font-size: 1rem;">
                    @if (Model.TotalTrades > 0)
                    {
                        <span class="text-profit">+$@Model.BestTrade.ToString("F2")</span>
                        <span class="text-secondary mx-1">/</span>
                        if (hasLoss)
                        {
                            <span class="text-loss">-$@Math.Abs(Model.WorstTrade).ToString("F2")</span>
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 0.7rem;">No losses</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted" style="font-size: 0.8rem;">No data</span>
                    }
                </div>
            </div>
        </div>
        <!-- NEW: Average P&L Card (replacing Avg R:R) -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-card text-center">
                <div class="stat-icon mx-auto" style="background: rgba(46, 204, 113, 0.15); color: var(--accent-green); width: 40px; height: 40px;">
                    <i class="fas fa-calculator"></i>
                </div>
                <div class="stat-label">Avg P&L</div>
                <div class="stat-value @(Model.AvgPnL >= 0 ? "text-profit" : "text-loss")" style="font-size: 1.5rem;">
                    @(Model.AvgPnL >= 0 ? "+" : "")$@Model.AvgPnL.ToString("F2")
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1: Cumulative + Symbol -->
    <div class="row g-3 mb-4">
        <div class="col-xl-7">
            <div class="card-glass">
                <div class="card-header">
                    <i class="fas fa-chart-line me-2" style="color: var(--accent-blue);"></i>Cumulative P&L
                </div>
                <div class="card-body">
                    <canvas id="cumulativeChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-5">
            <div class="card-glass">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-2" style="color: var(--accent-blue);"></i>P&L by Symbol
                </div>
                <div class="card-body">
                    <canvas id="symbolChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2: Setup + Monthly -->
    <div class="row g-3 mb-4">
        <div class="col-xl-4">
            <div class="card-glass">
                <div class="card-header">
                    <i class="fas fa-chart-pie me-2" style="color: var(--accent-blue);"></i>Win Rate by Setup
                </div>
                <div class="card-body">
                    <canvas id="setupChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-8">
            <div class="card-glass">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-2" style="color: var(--accent-blue);"></i>Monthly Performance
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Daily Bias & Confluence Analysis -->
    <div class="row g-3 mb-4">
        <div class="col-xl-6">
            <div class="card-glass">
                <div class="card-header">
                    <i class="fas fa-compass me-2" style="color: var(--accent-blue);"></i>Daily Bias Accuracy
                </div>
                <div class="card-body">
                    @if (Model.BiasAccuracy.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-custom">
                                <thead>
                                    <tr>
                                        <th>Bias</th>
                                        <th class="text-center">Trades</th>
                                        <th class="text-center">Wins</th>
                                        <th class="text-center">Win Rate</th>
                                        <th class="text-end">Avg P&L</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bias in Model.BiasAccuracy)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge-custom @(bias.Bias == "Bullish" ? "badge-long" : bias.Bias == "Bearish" ? "badge-short" : "")">
                                                    @bias.Bias
                                                </span>
                                            </td>
                                            <td class="text-center">@bias.TotalTrades</td>
                                            <td class="text-center">@bias.WinCount</td>
                                            <td class="text-center @(bias.WinRate >= 50 ? "text-profit" : "text-loss")">
                                                @bias.WinRate%
                                            </td>
                                            <td class="text-end @(bias.AvgPnL >= 0 ? "text-profit" : "text-loss")">
                                                $@bias.AvgPnL.ToString("F2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">No bias data available</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card-glass">
                <div class="card-header">
                    <i class="fas fa-link me-2" style="color: var(--accent-blue);"></i>Top Confluence Combinations
                </div>
                <div class="card-body">
                    @if (Model.ConfluencePerformance.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-custom">
                                <thead>
                                    <tr>
                                        <th>Confluence</th>
                                        <th class="text-center">Trades</th>
                                        <th class="text-center">Win Rate</th>
                                        <th class="text-end">Avg P&L</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var confluence in Model.ConfluencePerformance)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-secondary); padding: 0.2rem 0.7rem;">
                                                    @confluence.Confluence
                                                </span>
                                            </td>
                                            <td class="text-center">@confluence.Count</td>
                                            <td class="text-center text-profit">@confluence.WinRate%</td>
                                            <td class="text-end text-profit">$@confluence.AvgPnL.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">No confluence data available</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Key Insights -->
    @if (Model.Insights.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card-glass">
                    <div class="card-header">
                        <i class="fas fa-lightbulb me-2" style="color: var(--accent-gold);"></i>Key Insights
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var insight in Model.Insights)
                            {
                                <div class="col-xl-3 col-md-6">
                                    <div class="d-flex align-items-start gap-3 p-3" style="border-radius: var(--radius-sm); background: var(--bg-primary);">
                                        <div style="font-size: 1.5rem; color: @(insight.Color == "text-success" ? "var(--accent-green)" : insight.Color == "text-warning" ? "var(--accent-gold)" : insight.Color == "text-info" ? "var(--accent-blue)" : "var(--text-secondary)");">
                                            <i class="fas @insight.Icon"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight: 600; font-size: 0.9rem;">@insight.Title</div>
                                            <div style="font-size: 0.85rem; color: var(--text-secondary);">@insight.Description</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Trade History -->
    <div class="row">
        <div class="col-12">
            <div class="card-glass">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-history me-2" style="color: var(--accent-blue);"></i>Trade History</span>
                    <span class="text-secondary" style="font-size: 0.8rem; font-weight: 400;">
                        @Model.FilteredTrades.Count trades
                    </span>
                </div>
                <div class="card-body">
                    @if (!Model.FilteredTrades.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-inbox" style="font-size: 2rem; color: var(--text-muted);"></i>
                            <p class="text-muted mt-2">No trades found for this timeframe</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-custom" id="tradeHistoryTable">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Symbol</th>
                                        <th>Direction</th>
                                        <th>Entry</th>
                                        <th>Exit</th>
                                        <th>Setup</th>
                                        <th>Bias</th>
                                        <th class="text-end">P&L</th>
                                        <th class="text-center">Rating</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var trade in Model.FilteredTrades)
                                    {
                                        var pl = trade.ProfitLoss ?? 0;
                                        <tr>
                                            <td>
                                                <span style="font-weight: 500;">@trade.TradeDate.ToString("MM/dd")</span>
                                                <br />
                                                <span style="font-size: 0.65rem; color: var(--text-muted);">@trade.TradeDate.ToString("hh:mm tt")</span>
                                            </td>
                                            <td><span style="font-weight: 700;">@trade.Symbol</span></td>
                                            <td>
                                                <span class="badge-custom @(trade.Direction == "LONG" ? "badge-long" : "badge-short")">
                                                    @trade.Direction
                                                </span>
                                            </td>
                                            <td style="font-weight: 500;">@trade.EntryPrice.ToString("F2")</td>
                                            <td style="font-weight: 500;">@trade.ExitPrice.ToString("F2")</td>
                                            <td>
                                                <span style="font-size: 0.75rem; color: var(--text-secondary);">
                                                    @(trade.SetupType ?? "—")
                                                </span>
                                            </td>
                                            <td>
                                                <span style="font-size: 0.75rem; color: var(--text-secondary);">
                                                    @(trade.DailyBias ?? "—")
                                                </span>
                                            </td>
                                            <td class="text-end" style="font-weight: 700; @(pl >= 0 ? "color: var(--accent-green);" : "color: var(--accent-red);")">
                                                @(pl >= 0 ? "+" : "")$@pl.ToString("F2")
                                            </td>
                                            <td class="text-center">
                                                @if (trade.Rating.HasValue)
                                                {
                                                    for (int i = 1; i <= trade.Rating.Value; i++)
                                                    {
                                                        <i class="fas fa-star text-warning" style="font-size: 0.7rem;"></i>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-secondary" style="font-size: 0.7rem;">—</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex justify-content-center gap-1">
                                                    <button class="action-btn" onclick="viewTrade(@trade.Id)" title="View Details">
                                                        <i class="fas fa-eye" style="font-size: 0.85rem;"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Trade Modal -->
<div class="modal fade" id="tradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content modal-content-custom">
            <div class="modal-body p-0" id="tradeModalContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted mt-3">Loading trade details...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart data from server
        const cumulativeLabels = @Html.Raw(Json.Encode(Model.CumulativePnL.Select(c => c.Label)));
        const cumulativeData = @Html.Raw(Json.Encode(Model.CumulativePnL.Select(c => c.Value)));

        const symbolLabels = @Html.Raw(Json.Encode(Model.PnLBySymbol.Select(c => c.Label)));
        const symbolData = @Html.Raw(Json.Encode(Model.PnLBySymbol.Select(c => c.Value)));

        const setupLabels = @Html.Raw(Json.Encode(Model.WinRateBySetup.Select(c => c.Label)));
        const setupData = @Html.Raw(Json.Encode(Model.WinRateBySetup.Select(c => c.Value)));

        const monthlyLabels = @Html.Raw(Json.Encode(Model.MonthlyPerformance.Select(c => c.Label)));
        const monthlyData = @Html.Raw(Json.Encode(Model.MonthlyPerformance.Select(c => c.Value)));

        // Color palette
        const colors = {
            blue: '#4f8cf7',
            green: '#2ecc71',
            red: '#e74c3c',
            gold: '#f1c40f',
            purple: '#6c5ce7',
            teal: '#1abc9c',
            orange: '#e67e22',
            pink: '#fd79a8'
        };

        const chartColors = ['#4f8cf7', '#2ecc71', '#f1c40f', '#6c5ce7', '#e74c3c', '#1abc9c', '#e67e22', '#fd79a8'];

        // 1. Cumulative P&L Chart
        const ctx1 = document.getElementById('cumulativeChart').getContext('2d');
        new Chart(ctx1, {
            type: 'line',
            data: {
                labels: cumulativeLabels,
                datasets: [{
                    label: 'Cumulative P&L',
                    data: cumulativeData,
                    borderColor: colors.blue,
                    backgroundColor: 'rgba(79, 140, 247, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 2,
                    pointBackgroundColor: colors.blue,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        ticks: {
                            callback: function(value) { return '$' + value.toFixed(2); },
                            color: '#8899aa'
                        },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    },
                    x: {
                        ticks: { color: '#8899aa', maxTicksLimit: 20 },
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. P&L by Symbol Chart
        const ctx2 = document.getElementById('symbolChart').getContext('2d');
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: symbolLabels,
                datasets: [{
                    label: 'P&L by Symbol',
                    data: symbolData,
                    backgroundColor: symbolData.map(v => v >= 0 ? 'rgba(46, 204, 113, 0.7)' : 'rgba(231, 76, 60, 0.7)'),
                    borderColor: symbolData.map(v => v >= 0 ? '#2ecc71' : '#e74c3c'),
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        ticks: {
                            callback: function(value) { return '$' + value.toFixed(2); },
                            color: '#8899aa'
                        },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    },
                    x: {
                        ticks: { color: '#8899aa' },
                        grid: { display: false }
                    }
                }
            }
        });

        // 3. Win Rate by Setup Chart (Doughnut)
        const ctx3 = document.getElementById('setupChart').getContext('2d');
        new Chart(ctx3, {
            type: 'doughnut',
            data: {
                labels: setupLabels,
                datasets: [{
                    data: setupData,
                    backgroundColor: chartColors.slice(0, setupLabels.length),
                    borderColor: '#1a2332',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#8899aa',
                            padding: 15,
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    }
                }
            }
        });

        // 4. Monthly Performance Chart
        const ctx4 = document.getElementById('monthlyChart').getContext('2d');
        new Chart(ctx4, {
            type: 'bar',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'Monthly P&L',
                    data: monthlyData,
                    backgroundColor: monthlyData.map(v => v >= 0 ? 'rgba(46, 204, 113, 0.7)' : 'rgba(231, 76, 60, 0.7)'),
                    borderColor: monthlyData.map(v => v >= 0 ? '#2ecc71' : '#e74c3c'),
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        ticks: {
                            callback: function(value) { return '$' + value.toFixed(2); },
                            color: '#8899aa'
                        },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    },
                    x: {
                        ticks: { color: '#8899aa' },
                        grid: { display: false }
                    }
                }
            }
        });

        // Timeframe filter
        $('#timeframeFilter .btn').on('click', function() {
            const value = $(this).data('value');
            if (value === 'custom') {
                $('#customRange').show();
                return;
            }
            $('#customRange').hide();
            window.location.href = '@Url.Action("Index")?timeframe=' + value;
        });

        $('#applyCustomRange').on('click', function() {
            const startDate = $('#startDate').val();
            const endDate = $('#endDate').val();
            if (startDate && endDate) {
                window.location.href = '@Url.Action("Index")?timeframe=custom&startDate=' + startDate + '&endDate=' + endDate;
            } else {
                alert('Please select both start and end dates.');
            }
        });

        // View Trade function
        function viewTrade(id) {
            $('#tradeModalContent').html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted mt-3">Loading trade details...</p>
                </div>
            `);
            $('#tradeModal').modal('show');
            $.get('@Url.Action("Details", "Trades")?id=' + id, function(data) {
                $('#tradeModalContent').html(data);
            });
        }
    </script>
}